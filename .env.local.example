# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Square ───────────────────────────────────────────────────────────────────
SQUARE_APPLICATION_ID=sq0idp_...
SQUARE_ACCESS_TOKEN=EAAA...
SQUARE_LOCATION_ID=location_id_here
SQUARE_ENVIRONMENT=sandbox

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@rubysrelics.com
RESEND_FROM_NAME=Ruby's Relics

# ─── USPS ─────────────────────────────────────────────────────────────────────
USPS_CONSUMER_KEY=your_usps_consumer_key
USPS_CONSUMER_SECRET=your_usps_consumer_secret

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_LOGIN_KEY=your_admin_secret_key_min_32_chars