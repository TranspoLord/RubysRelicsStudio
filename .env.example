# ─── Public site URL ─────────────────────────────────────────────────────────
# Canonical origin of this deployment. Used to build the Google OAuth
# `redirectTo` URL, so it MUST be registered in the Supabase dashboard under
# Authentication → URL Configuration → Redirect URLs, e.g.
#   production:  https://your-domain.com/auth/callback
#   local:       http://localhost:3000/auth/callback
# Vercel previews fall back to NEXT_PUBLIC_VERCEL_URL when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Auth + database) ──────────────────────────────────────────────
# Project URL and public API key. Safe to expose to the browser (RLS protects
# the data). Get them from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Newer name for the same public key. Takes precedence when set (see
# src/lib/supabase/env.ts). Use one or the other, not both.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Branch isolation used by src/lib/supabase/client.ts (development | test | production)
NEXT_PUBLIC_APP_ENV=development

# ─── Local Supabase CLI only ─────────────────────────────────────────────────
# Consumed by supabase/config.toml (`[auth.external.google]`) for `supabase
# start`. Not used by the Next.js app, and not needed on Vercel — the hosted
# project stores the Google credentials in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret

# ─── Admin authentication ────────────────────────────────────────────────────
# The /admin panel authenticates through Supabase Auth (Google) against the
# `exp_admin_users` allow-list — see README.md "Admin access" and
# SEPT_IMPLEMENTATION_PLAN.md §10. No admin-specific secrets are needed.
#
# `ADMIN_LOGIN_KEY`, `ADMIN_MFA_EMAIL`, `SESSION_SIGNING_KEY_SEED`,
# `SESSION_HASH_KEY_SEED` and `MFA_CODE_HASH_KEY_SEED` were removed by §10.13
# along with the key + emailed-MFA flow they served.
#
# ─── Dev-only admin sign-in helper (OCT #10) ─────────────────────────────────
# DO NOT set these in `.env`. The helper (`GET /api/dev/session`, UI_AUDIT.md
# §15) mints a real admin session against whatever NEXT_PUBLIC_SUPABASE_URL
# points at — and this project's dev environment points at the *production*
# project — so they are passed as process environment variables for a single
# `npm run dev` run, and removed afterwards:
#
#   $env:ADMIN_DEV_SIGNIN_ENABLED     = 'true'
#   $env:ADMIN_DEV_SIGNIN_ALLOW_HOSTED = 'true'   # required for a hosted project
#   $env:ADMIN_DEV_SIGNIN_TOKEN       = '<at least 32 characters>'
#   npm run dev -- -p 3210
#
# `npm run dev` binds every interface, so the flag alone is not a gate: the route
# 404s without the matching `x-dev-signin-token` header. It also refuses a
# non-loopback Host header, a cross-site fetch, and a hosted Supabase project
# without ADMIN_DEV_SIGNIN_ALLOW_HOSTED=true.
#
# ADMIN_DEV_SIGNIN_ENABLED=true
# ADMIN_DEV_SIGNIN_ALLOW_HOSTED=true
# ADMIN_DEV_SIGNIN_TOKEN=

# ─── Square webhooks ─────────────────────────────────────────────────────────
# BOTH are required. The route fails closed with 500 when either is missing, so
# Square's payment events are dropped and no order is ever marked paid.
#
# `SQUARE_WEBHOOK_NOTIFICATION_URL` must match the notification URL on the Square
# webhook subscription CHARACTER FOR CHARACTER. Square signs
# `notificationUrl + body` with HMAC-SHA256, so a trailing slash, an http/https
# difference or a `www.` prefix makes every signature fail (401).
#
#   production: https://your-domain.com/api/webhooks/square
#   local:      http://localhost:3000/api/webhooks/square
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.com/api/webhooks/square

# Square dashboard → Developer → Webhooks → your subscription → Signature key.
# Editing a subscription keeps its key; deleting and recreating it issues a NEW
# key, which must be copied here or every webhook 401s.
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# ─── Square (payments) ───────────────────────────────────────────────────────
# `sandbox` uses connect.squareupsandbox.com and sandbox payment links (no real
# money); `production` uses connect.squareup.com. The webhook subscription must
# live in the SAME environment as this value, or its signature key will not match.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id

# ─── Shippo (labels + tracking webhooks) ─────────────────────────────────────
# `SHIPPO_TEST_MODE=true` uses Shippo's test tokens and prints test labels.
SHIPPO_API_TOKEN=your-shippo-api-token
SHIPPO_TEST_MODE=true

# Webhook credentials — the route fails closed (500) when BOTH are unset, and
# 401s when neither matches. Shippo's dashboard can either sign the body with
# HMAC-SHA256 (`x-shippo-signature`, hex — tried first) or send only a secret URL
# token; configure whichever the dashboard gives you:
#   https://your-domain.com/api/shippo/webhook?token=<SHIPPO_WEBHOOK_TOKEN>
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret
SHIPPO_WEBHOOK_TOKEN=your-shippo-webhook-url-token

# Origin address for label purchases (Shippo requires a complete address).
SHIPPO_FROM_STREET=1 Main St
SHIPPO_FROM_CITY=Springfield
SHIPPO_FROM_STATE=IL
SHIPPO_FROM_ZIP=62701


