# ─── Public site URL ─────────────────────────────────────────────────────────
# Canonical origin of this deployment. Used to build the Google OAuth
# `redirectTo` URL, so it MUST be registered in the Supabase dashboard under
# Authentication → URL Configuration → Redirect URLs, e.g.
#   production:  https://your-domain.com/auth/callback
#   local:       http://localhost:3000/auth/callback
# Vercel previews fall back to NEXT_PUBLIC_VERCEL_URL when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Auth + database) ──────────────────────────────────────────────
# Project URL and public API key. Safe to expose to the browser (RLS protects
# the data). Get them from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Newer name for the same public key. Takes precedence when set (see
# src/lib/supabase/env.ts). Use one or the other, not both.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Branch isolation used by src/lib/supabase/client.ts (development | test | production)
NEXT_PUBLIC_APP_ENV=development

# ─── Local Supabase CLI only ─────────────────────────────────────────────────
# Consumed by supabase/config.toml (`[auth.external.google]`) for `supabase
# start`. Not used by the Next.js app, and not needed on Vercel — the hosted
# project stores the Google credentials in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret

# ─── Admin authentication ────────────────────────────────────────────────────
# The /admin panel authenticates through Supabase Auth (Google) against the
# `exp_admin_users` allow-list — see README.md "Admin access" and
# SEPT_IMPLEMENTATION_PLAN.md §10. No admin-specific secrets are needed.
#
# `ADMIN_LOGIN_KEY`, `ADMIN_MFA_EMAIL`, `SESSION_SIGNING_KEY_SEED`,
# `SESSION_HASH_KEY_SEED` and `MFA_CODE_HASH_KEY_SEED` were removed by §10.13
# along with the key + emailed-MFA flow they served.
