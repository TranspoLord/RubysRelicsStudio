{
  "name": "rubys-relics-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security:rls": "node ./scripts/test-rls-lockdown.mjs",
    "test:security": "npm run test:security:rls && npm run audit",
    "test:square": "node ./scripts/test-square-checkout.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/types/database.ts",
    "admin:grant": "node ./scripts/grant-admin.mjs",
    "admin:revoke": "node ./scripts/revoke-admin.mjs",
    "admin:reset-mfa": "node ./scripts/reset-admin-mfa.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@vercel/analytics": "^1.4.0",
    "@xmldom/xmldom": "^0.9.10",
    "konva": "^10.3.0",
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.5",
    "resend": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
